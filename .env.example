# =====================================================================
# Ambo University HRMS - Environment Configuration & Security Blueprint
# =====================================================================

# 1. Backend REST API URL
# Points to the Express/NestJS backend service. If unreachable or running statically,
# the application automatically engages its persistent dual-mode localStorage engine.
VITE_API_URL=http://localhost:3000/api

# 2. AI Assistant Backend API URL (Optional)
# If provided, the multilingual ChatBot delegates complex user queries to this endpoint.
# When unavailable or offline, the ChatBot seamlessly runs on its built-in
# trilingual domain knowledge base (covering forms, leaves, attendance, and policies).
# VITE_AI_API_URL=http://localhost:3000/api/ai

# 3. Cryptographic Authentication Salt
# Used for client/server PBKDF2-SHA256 (100,000 rounds) password hash derivations.
VITE_AUTH_SALT=ambo_univ_hrms_salt_sec_2026

# =====================================================================
# Provisioned Initial Accounts & Role-Based Access Control (RBAC)
# Note: Raw passwords are NEVER stored in plaintext. They are validated
# against 100,000-iteration PBKDF2-SHA256 derived keys.
